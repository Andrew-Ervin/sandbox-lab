# Public model routing defaults; .env/process settings override these.
# Temporary prototype policy. Enforce ZDR again before using sensitive data.
OPENROUTER_REQUIRE_ZDR=false
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_PROVIDER_ORDER=amazon-bedrock,openai
OPENROUTER_PROVIDER_IGNORE=azure
# Comma-separated OpenRouter model IDs exposed through the workspace-only Ori
# gateway. Luna remains the default. Add a model only after recording its price
# in the Azure pilot configuration, so its use remains inside the $200 guard.
WORKSPACE_MODELS=
