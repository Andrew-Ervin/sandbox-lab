# Public operational defaults. .env or process environment overrides these.
# Restart local services after edits. See docs/LIMITS.md for cluster/build steps.
WARM_POOL_SIZE=2
WARM_POOL_MAX=4
QUICK_CONCURRENCY=4
QUICK_MAX_PODS=8
QUICK_IDLE_SECONDS=300
PROJECT_CONCURRENCY=2
PROJECT_MAX_RUNNING=4
PROJECT_IDLE_SECONDS=300
PROJECT_WARM_RESERVE=1
PROJECT_RESERVE_IDLE_SECONDS=300
DEVELOPER_IDLE_SECONDS=600
PREVIEW_IDLE_SECONDS=120
JOB_CONCURRENCY=8
JOB_MAX_PENDING=64
AI_STORAGE_QUOTA=100Gi
AI_MAX_RETAINED_WORKSPACES=50
DEVELOPER_STORAGE_QUOTA=40Gi
DEVELOPER_MAX_RETAINED_WORKSPACES=20
DEVELOPER_MAX_RUNNING=3
# Source transfers, including the local OneDrive mock.
SYNC_MAX_FILES=2000
SYNC_MAX_FILE_BYTES=8000000
SYNC_MAX_TOTAL_BYTES=32000000
SYNC_MAX_ENTRIES=10000
SYNC_MAX_IMPORTS=3
SYNC_CONCURRENCY=2
PROJECT_SYNC_SECONDS=15
# Conversation inputs, artifacts and quick checkpoints.
ARTIFACT_MAX_FILES=40
ARTIFACT_MAX_FILE_BYTES=8000000
ARTIFACT_MAX_TOTAL_BYTES=16000000
QUICK_CODE_CHARS=100000
QUICK_CPU_SECONDS=25
QUICK_RUN_SECONDS=30
QUICK_STDOUT_BYTES=64000
# Dictation: mono PCM16 at 16 kHz; five minutes is 9,600,044 bytes.
DICTATION_MAX_SECONDS=300
DICTATION_MAX_BYTES=10000000
MODEL_MAX_BODY_BYTES=2000000

# General assistant routing/prose; workspace harnesses keep their own context limits.
CHAT_MAX_OUTPUT_TOKENS=4096
CHAT_PROVIDER_ATTEMPTS=3
ORI_RUN_SECONDS=600
NATIVE_RUN_SECONDS=900

# Local launcher rotates only the namespaced quick broker token.
BROKER_TOKEN_SECONDS=86400
BROKER_RENEW_BEFORE_SECONDS=3600

# OpenRouter server-side Exa search, per model request.
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_MAX_TOTAL_RESULTS=6
WEB_SEARCH_MAX_USES=2

# Scoped workspace model credentials retain a hard one-hour lifetime.
WORKSPACE_TOKEN_RENEW_BEFORE_SECONDS=300
# Native Coder activity polling and persisted UI detail bounds.
NATIVE_TELEMETRY_SECONDS=5
NATIVE_TELEMETRY_MAX_CHARS=24000
NATIVE_TELEMETRY_MAX_MESSAGES=200
NATIVE_STATUS_SECONDS=5
CODER_READ_ATTEMPTS=3
APP_PACKAGE_RESTORE_SECONDS=120
