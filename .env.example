OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
CHATKIT_DOMAIN_KEY=domain_pk_localhost_dev
LAB_TOKEN_SECRET=
# Optional: coder-native; see docs/NATIVE_CODER_TRIAL.md before switching.
PROJECT_ENGINE=ori-pi

OPENROUTER_REASONING=xhigh



# Trusted gateway setting. Search is a separate outbound disclosure path.
LAB_ALLOW_WEB_SEARCH=true

# Optional private mock-email experiment; disabled in clean installations.
LAB_ENABLE_MCP_EXPERIMENT=false

# Saved developer homes are independent of the three-running-pod limit.
# Capacity, file limits and idle timers: config/limits.env (override here if needed).

# Model routing and temporary ZDR switch: config/models.env.
