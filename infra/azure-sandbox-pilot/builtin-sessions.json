{
  "$schema":"https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion":"1.0.0.0",
  "parameters":{
    "poolName":{"type":"string","defaultValue":"labpythonbuiltin"},
    "location":{"type":"string","defaultValue":"[resourceGroup().location]"},
    "maxSessions":{"type":"int","defaultValue":10,"minValue":1,"maxValue":600}
  },
  "resources":[{
    "type":"Microsoft.App/sessionPools","apiVersion":"2025-07-01",
    "name":"[parameters('poolName')]","location":"[parameters('location')]",
    "tags":{"application":"sandbox-lab","billing":"session-hours"},
    "properties":{
      "containerType":"PythonLTS","poolManagementType":"Dynamic",
      "scaleConfiguration":{"maxConcurrentSessions":"[parameters('maxSessions')]"},
      "dynamicPoolConfiguration":{"lifecycleConfiguration":{"lifecycleType":"Timed","cooldownPeriodInSeconds":3300}},
      "sessionNetworkConfiguration":{"status":"EgressDisabled"}
    }
  }]
}
